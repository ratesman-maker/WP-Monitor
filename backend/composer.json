{
    "name": "wp-monitor/backend",
    "description": "WP Monitor — WordPress site management dashboard (backend)",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-sodium": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "slim/slim": "^4.13",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^3.7",
        "symfony/event-dispatcher": "^7.1",
        "symfony/validator": "^7.1",
        "symfony/serializer": "^7.1",
        "ramsey/uuid": "^4.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "WPMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPMonitor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer check --verbose --allow-risky=yes",
        "cs-fix": "php-cs-fixer fix --verbose --allow-risky=yes",
        "audit": "composer audit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
